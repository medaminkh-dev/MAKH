# Build artifacts
*.o
*.d
*.iso
*.kernel
*.log
*.txt

# Directories
iso_check/

# Generated initrd archive
initrd.tar

# initrd source content is tracked despite the generic *.txt rule
!initrd/
!initrd/**

# The checked-in musl sysroot (F21-b) ships prebuilt crt objects — these are
# vendored toolchain inputs, not build output, so override the generic *.o rule.
!user/sysroot/usr/lib/*.o

# Build artifacts
build/
